{
  "name": "projectmeats-frontend",
  "version": "1.0.0",
  "description": "React frontend for ProjectMeats - migrated from PowerApps. For active priorities, see MASTER_PLAN.md",
  "type": "module",
  "private": true,
  "_comments": {
    "react-table-migration": "TODO: Replace react-table@7.8.0 with @tanstack/react-table (TanStack Table v8) for React 19 compatibility. See: https://tanstack.com/table/latest"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@mona-health/react-input-mask": "^3.0.3",
    "@monaco-editor/react": "^4.7.0",
    "@sentry/react": "^10.53.1",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.10.2",
    "antd": "^6.4.3",
    "axios": "^1.16.1",
    "colorthief": "^3.3.1",
    "country-list": "^2.4.1",
    "dagre": "^0.8.5",
    "date-fns": "^4.2.1",
    "dompurify": "^3.4.5",
    "framer-motion": "^12.39.0",
    "fuse.js": "^7.3.0",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-grid-layout": "^2.2.3",
    "react-hook-form": "^7.76.0",
    "react-hot-toast": "^2.6.0",
    "react-hotkeys-hook": "^5.3.2",
    "react-i18next": "^17.0.8",
    "react-is": "^19.2.6",
    "react-joyride": "^3.1.0",
    "react-router-dom": "^7.15.1",
    "react-select": "^5.10.2",
    "recharts": "^3.8.1",
    "styled-components": "^6.4.1",
    "use-undo": "^1.2.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:ci": "mkdir -p coverage/.tmp && vitest run --coverage",
    "type-check": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,json,css,md}",
    "lint": "eslint src/**/*.{js,jsx,ts,tsx}",
    "lint:fix": "eslint src/**/*.{js,jsx,ts,tsx} --fix",
    "lint:colors": "node .eslint/scripts/check-colors.cjs",
    "lint:colors:fix": "node .eslint/scripts/check-colors.cjs --fix",
    "lint:render-stability": "node .eslint/scripts/check-render-stability.cjs",
    "lint:query-keys": "node .eslint/scripts/check-query-key-scoping.cjs",
    "lint:query-error-handling": "node .eslint/scripts/check-query-error-handling.cjs",
    "lint:api-boundaries": "node .eslint/scripts/check-api-import-boundaries.cjs",
    "lint:any-regression": "node .eslint/scripts/check-any-regression.cjs",
    "lint:console-usage": "node .eslint/scripts/check-console-usage.cjs",
    "lint:circular-deps": "node .eslint/scripts/check-circular-deps.cjs",
    "lint:pre-deploy": "node .eslint/scripts/pre-deploy-audit.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "analyze": "vite build --mode analyze",
    "serve": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "verify-standards": "npm run type-check && npm run lint && npm run lint:colors && npm run lint:render-stability && npm run lint:query-keys && npm run lint:query-error-handling && npm run lint:api-boundaries && npm run lint:any-regression && npm run lint:console-usage && npm run lint:circular-deps && echo '✅ Frontend standards verification passed'"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.3",
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-onboarding": "^10.4.0",
    "@storybook/react-webpack5": "^10.4.0",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.53",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "autoprefixer": "^10.5.0",
    "babel-plugin-styled-components": "^2.1.4",
    "eslint": "^10.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "prop-types": "^15.8.1",
    "react-refresh": "^0.18.0",
    "serve": "^14.2.6",
    "storybook": "^10.4.0",
    "tailwindcss": "3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.6",
    "webpack": "^5.106.2",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@types/d3-dispatch": "^1.0.11"
  },
  "proxy": "http://localhost:8000"
}
