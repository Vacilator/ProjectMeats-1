      "risk_level": "high",
      "required_checks": [
        "cd backend && python manage.py makemigrations",
        "cd backend && python manage.py makemigrations --check",
        "cd backend && python manage.py migrate --plan"
      ]
    },
    {
      "id": "ci-cd-change",
      "playbook_file": ".copilot/squad/tasks/ci-cd-workflow-changes.md",
