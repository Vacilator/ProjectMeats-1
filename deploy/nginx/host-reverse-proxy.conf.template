# Host-level Nginx Reverse Proxy Configuration
# This file should be deployed to /etc/nginx/sites-available/projectmeats on the host
#
# Purpose: Route external traffic from public domains to Docker containers
# Architecture: Public Internet → Host Nginx → Docker Containers
#
# Replace these placeholders before deployment:
# - ${DOMAIN_NAME}: e.g., dev.meatscentral.com, uat.meatscentral.com, meatscentral.com
# - ${BACKEND_HOST}: Backend container IP or use host.docker.internal if Docker Desktop

# Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN_NAME};

    # Allow Let's Encrypt ACME challenge (certbot webroot mode)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    # Redirect all other HTTP traffic to HTTPS
    location / {
        return 301 https://$server_name$request_uri;
    }
}

# HTTPS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DOMAIN_NAME};
    client_max_body_size 50M;

    # MIME types configuration for proper content type handling
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # SSL certificates (Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;

    # Modern SSL configuration (Mozilla Intermediate)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Proxy headers (passed to all backend locations)
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    # Timeouts and buffers
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    proxy_buffering off;
    proxy_request_buffering off;

    # Backend API routes (Django) - Route to backend container
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Django Admin - Route to backend container
    location /admin/ {
        proxy_pass http://${BACKEND_HOST}:8000;
    }

    # Django static files (admin CSS/JS) - Route to backend container
    # CRITICAL: Proper MIME types ensure admin UI styling works correctly
    location /static/ {
        proxy_pass http://${BACKEND_HOST}:8000;

        # Ensure browsers trust CSS and JS files
        add_header X-Content-Type-Options "nosniff" always;

        # Cache static files for performance
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    # Media files (user uploads) - Route to backend container
    location /media/ {
        proxy_pass http://${BACKEND_HOST}:8000;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    # Websocket routes (AI inbox and future real-time features)
    location /ws/ {
        proxy_pass http://${BACKEND_HOST}:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }

    # Health check endpoint (bypass frontend)
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # Frontend React app (served by frontend container nginx)
    # This must be LAST to act as fallback
    location / {
        proxy_pass http://127.0.0.1:8080;

        # SPA routing support
        proxy_intercept_errors on;
        error_page 404 = @frontend_fallback;

        # Prevent caching of index.html at the proxy layer.
        # Content-hashed assets (JS/CSS) are cached by the inner nginx;
        # index.html MUST be fresh so chunk references match the current build.
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    # SPA fallback for client-side routing
    location @frontend_fallback {
        proxy_pass http://127.0.0.1:8080;
    }
}
